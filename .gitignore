# Build output — one directory per hostname, regenerated by tools/build-domains.mjs
dist/

# Review captures: ~12MB of screenshots regenerated on demand. The decision
# record (.impeccable/decision.json) and the questions are kept — they are the
# reasoning behind the design and cannot be regenerated.
.impeccable/review/

# Ephemeral state from the decision-page server, not a record of anything.
.impeccable/questions/

# assets/i18n/_locales.raw.json is deliberately NOT ignored: it is the offline
# fallback tools/build-locales.mjs reads when neither --api nor --db is given,
# so a fresh clone can rebuild the manifest without the dictionary to hand.

.DS_Store
node_modules/
